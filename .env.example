# Copy to .env and adjust. Never commit the real .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://supportai:supportai_dev_password@db:5432/supportai
DATABASE_URL_SYNC=postgresql+psycopg://supportai:supportai_dev_password@db:5432/supportai

# --- Auth (D012) ---
JWT_SECRET=change_me_to_a_long_random_value_in_real_envs
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Must exactly match the frontend origin (scheme + host + port) - required for credentialed
# (cookie) requests, where CORS forbids a wildcard. Next.js dev server default:
ALLOWED_ORIGINS=http://localhost:3000

# --- Storage (Phase 3) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/data/uploads
MAX_UPLOAD_SIZE_MB=25

# --- AI providers (D007) ---
AI_GENERATION_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=local_sentence_transformers
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# --- Reranking (D011) ---
RERANK_ENABLED=true
AI_RERANK_PROVIDER=cross_encoder_local
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL_SIZE=20
RERANK_TOP_N=5

# Optional hosted providers - disabled unless explicitly configured (never required)
# AI_GENERATION_PROVIDER=hosted_openai_compatible
# HOSTED_AI_API_KEY=
# HOSTED_AI_BASE_URL=
